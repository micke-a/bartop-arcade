# Copy to .local/pi.env (gitignored) and adjust.
# PI_HOST can be a Host alias from ~/.ssh/config (recommended, see README), a hostname or an IP.
PI_HOST=retropie
PI_USER=pi
# Only needed if SSH isn't on port 22 and you don't set Port in ~/.ssh/config.
# PI_PORT=22
# Space-separated ROM folders. Only file NAMES are read, to stop game names leaking into git.
ROM_DIRS=/home/pi/RetroPie/roms /media/usb0/retropie-mount/roms
